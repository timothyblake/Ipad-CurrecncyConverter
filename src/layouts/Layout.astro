---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f6f5" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Currency" />
    <meta name="description" content="A simple travel currency converter for Jamaican dollars, British pounds, US dollars and euros." />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-currency-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon-currency.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>Currency Converter · The Travel Companion</title>
  </head>
  <body><slot /><script>
    if ('serviceWorker' in navigator && import.meta.env.PROD) {
      window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
    }
  </script></body>
</html>
